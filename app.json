{
  "expo": {
    "name": "GP Patch Lab",
    "slug": "gp-patch-lab",
    "scheme": "gppatchlab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gppatchlab.app",
      "infoPlist": {
        "UIBackgroundModes": [],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121212"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.gppatchlab.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./modules/expo-usb-midi/app.plugin.js"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e54d6ce6-f0a2-4b7c-996a-3fbd9256011c"
      }
    },
    "owner": "kaprrrr"
  }
}
